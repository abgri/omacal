{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmaCal Brian",
  "mainBinaryName": "omacal-brian",
  "version": "6.3.0",
  "identifier": "com.brianacklen.omacal",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmaCal Brian",
        "visible": false,
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Overlay",
        "zoomHotkeysEnabled": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": [
      "icu-tz/*.res"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/omacal.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/omacal.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/omacal.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/omacal.svg": "icons/icon.svg"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/omacal.svg": "icons/icon.svg"
        }
      }
    }
  }
}
